# MAGIC ## Simulation #3 - Data Quality and Dedup testing
# MAGIC goal is to have 3 dataframes, "valid_claims_df", "invalid_claims_df" and "latest_valid_claims_df"

# COMMAND ----------

# valid_claims_df

valid_claims_df = claims_df.filter( 
    (F.col("claim_amount") > 0) &
    (F.col("status").isin("PENDING", "CLOSED", "OPEN")) &
    (F.col("claim_id").isNotNull() & F.col("policy_id").isNotNull())
)

# display(valid_claims_df)

# invalid_claims_df

validation_condition = (
    (F.col("claim_amount") > 0) &
    (F.col("status").isin("PENDING", "CLOSED", "OPEN")) &
    (F.col("claim_id").isNotNull()) &
    (F.col("policy_id").isNotNull())
)

invalid_claims_df = claims_df.filter(
    ~F.coalesce(validation_condition, F.lit(False))
)

# display(invalid_claims_df)

# A control point for number of valid and invalid cases

assert (
    claims_df.count()
    == valid_claims_df.count() + invalid_claims_df.count()
)

# latest_valid_claims_df

window_spec = Window \
    .partitionBy("claim_id") \
    .orderBy(F.col("updated_at").desc())

ranked_df = valid_claims_df.withColumn(
    "row_num",
    F.row_number().over(window_spec)
)

latest_valid_claims_df = ranked_df.filter(
    F.col("row_num") == 1
).drop("row_num")

display(latest_valid_claims_df)



