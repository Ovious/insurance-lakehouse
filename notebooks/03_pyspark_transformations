# MAGIC %md
# MAGIC ## Simulation #4 - Silver operations
# MAGIC
# MAGIC #### At this level the data should be used directly from source batches under insurance_copmany Catalog, treating previously defined dataframes as tests and simulations
# MAGIC
# MAGIC Target : insurance_company.insurance_silver.claims_enriched
# MAGIC Source : Bronze table filled with new batch of data

# COMMAND ----------

from pyspark.sql.window import Window

bronze_df = spark.table(
    "insurance_company.insurance_bronze.claims"
)


window_spec = (
    Window
    .partitionBy("claim_id")
    .orderBy(
        F.col("source_event_timestamp").desc(),
        F.col("ingestion_timestamp").desc()
    )
)

latest_claims_df = (
    bronze_df
    .withColumn(
        "row_num",
        F.row_number().over(window_spec)
    )
    .filter(F.col("row_num") == 1)
    .drop("row_num")
)

enriched_df = latest_claims_df.join(
    policies_df,
    on="policy_id",
    how="inner"
).filter(
    (F.col("claim_amount") > 0.0 ) &
    (F.col("status").isin(["PENDING", "CLOSED", "OPEN"])) &
    (F.col("claim_id").isNotNull()) &
    (F.col("policy_id").isNotNull())
)

silver_df = enriched_df.select(
    "claim_id",
    "policy_id",
    "customer_id",
    "policy_type",
    "claim_amount",
    "status",
    "source_event_timestamp"
)

(
    silver_df.write
    .format("delta")
    .mode("overwrite")
    .option("overwriteSchema", "true")
    .saveAsTable("insurance_company.insurance_silver.claims_enriched")
)
